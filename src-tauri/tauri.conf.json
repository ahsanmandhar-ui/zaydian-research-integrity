{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Zaydian Research Integrity",
  "version": "0.4.1",
  "identifier": "com.zaydian.researchintegrity",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/YOUR_USERNAME/zaydian-research-integrity/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwRDhFOEE5Q0JGOUM5RTUKUldUbHlmbkxxZWpZQUtmaTdIZHljWmZaeW5TV3MxejUvbWd5MTYzNnhyakN0a29QdDhrZGE1c08K"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Zaydian Research Integrity",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://stun.l.google.com:19302 https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
